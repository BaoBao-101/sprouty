# Dependencies
node_modules/
backend/node_modules/

# Environment — never commit secrets
.env
backend/.env

# Prisma generated client (regenerated on build)
backend/node_modules/.prisma/

# OS / editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/settings.json

# Logs
*.log
npm-debug.log*

# Build outputs
dist/

# Archives — do not commit large zip files
*.zip

# Local tooling / backups — not project source
.claude/
.migration-backup/

# Runtime uploads (served from backend_uploads volume in production)
backend/uploads/*
!backend/uploads/.gitkeep

# Cau hinh chay local — khong dua len GitHub
docker-compose.local.yml
