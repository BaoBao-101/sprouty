# ── Postgres ──────────────────────────────────────────────────
# Generate a strong random password: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-to-a-strong-random-password

# ── Server ────────────────────────────────────────────────────
NODE_ENV=production

# ── Cookies ───────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Required: the session cookie is signed with this, so changing it signs every
# logged-in user out.
COOKIE_SECRET=change-me-to-a-long-random-string
# HMAC secret for deterministic post-purchase redeem codes. Required in
# production — the server refuses to mint codes rather than fall back to the
# value in the repository, which anyone could read (finding F-12). Falls back to
# COOKIE_SECRET if unset.
REDEEM_CODE_SECRET=change-me-to-a-separate-long-random-string
# Sends the session cookie only over HTTPS. Defaults to on when
# NODE_ENV=production, and production refuses to start if you turn it off.
# Leave it unset unless you are serving the site over plain HTTP on purpose.
# COOKIE_SECURE=true

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGIN=https://sprouty.id.vn
# Set true only when the reverse proxy strips/overwrites X-Forwarded-* headers.
TRUST_PROXY=false

# ── AI Provider (at least one is required for chatbot) ─────────
AI_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_URL=http://ollama:11434
AI_MODEL=gpt-4.1-mini
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_REQUIRES_ENTITLEMENT=false

# ── SePay Payments ────────────────────────────────────────────
# Webhook API Key from SePay dashboard → WebHooks → "API Key" auth method.
# This is the Apikey value SePay sends in the Authorization header.
SEPAY_API_KEY=
# Bank account that SePay watches (linked at Ngân hàng → Kết nối tài khoản).
# Bank short code used by qr.sepay.vn/VietQR (VCB, MB, TCB, ACB, BIDV, ICB for VietinBank, ...).
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# ── Asset storage ─────────────────────────────────────────────
ASSET_STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
PUBLIC_ASSET_BASE_URL=/uploads
MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=500
# Cây Kỷ Niệm "leaf" videos (user phone clips, not admin instruction videos).
MAX_LEAF_VIDEO_UPLOAD_MB=50

# S3-compatible storage
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# ── Virtual plants (cây mô phỏng) ─────────────────────────────
# Sprouty no longer ships a physical kit: buying one unlocks a simulated plant
# that is activated with the order's code and raised on the site.
#
# Speeds the whole simulation up, for development and demos. 1 is real time, so
# a 4-hour watering cooldown really is 4 hours. 24 makes an hour pass in a
# minute — handy for walking through a full seed-to-harvest journey, and it
# must stay at 1 in production or every cooldown collapses.
PLANT_TIME_SCALE=1
# Timezone the day/night light curve and the care streak are measured in,
# as an offset from UTC. 7 = Asia/Ho_Chi_Minh.
PLANT_TZ_OFFSET=7

# ── Promotions ────────────────────────────────────────────────
# Qualifying kit purchases that earn one free workshop seat ("mua 3 tặng 1").
WORKSHOP_REWARD_THRESHOLD=3

# ── Shipping ──────────────────────────────────────────────────
# Product categories that have to be physically delivered, comma-separated.
# Empty — every product is digital now, so checkout never asks for an address.
# Setting e.g. "kit" would bring the address form and its validation back.
PHYSICAL_CATEGORIES=

# ── Simulated payments (local / demo only) ────────────────────
# Lets the payment page credit an order with no bank transaction behind it, so
# the activation code, the plant and the workshop reward can be exercised
# without a live SePay account. Requires NODE_ENV to not be "production" as
# well, so setting this on the real server has no effect. Every use is audited
# as `payment.simulated`.
ALLOW_FAKE_PAYMENTS=false
