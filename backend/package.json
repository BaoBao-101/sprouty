{
  "name": "sprouty-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node node_modules/prisma/build/index.js migrate deploy",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:seed": "node prisma/seed.js",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "assets:migrate-s3": "node scripts/migrate-assets-to-s3.js",
    "videos:migrate": "node scripts/migrate-product-videos.js",
    "demo:plants": "node scripts/seed-demo-plants.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1069.0",
    "@aws-sdk/s3-request-presigner": "^3.1069.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^9.1.3",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "marked": "^18.0.5",
    "node-fetch": "^3.3.2",
    "sanitize-html": "^2.17.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "overrides": {
    "fast-uri": "^4.0.0"
  }
}