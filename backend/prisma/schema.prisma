generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  employee
  admin
}

enum UserStatus {
  active
  disabled
}

enum ProductStatus {
  published
  draft
  archived
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum AssetKind {
  product_image
  instruction_video
  instruction_video_thumb
  user_image
  blog_cover
  blog_inline
}

enum AssetStorageProvider {
  local
  s3
}

enum ContentStatus {
  draft
  published
  archived
}

enum UserImageStatus {
  active
  hidden
  deleted
}

enum RedeemFeature {
  ai_assistant
  instruction_videos
  image_uploads
}

enum RedeemCodeStatus {
  active
  disabled
  expired
}

enum EntitlementSource {
  purchase
  redeem_code
  admin_grant
}

enum BlogPostStatus {
  draft
  published
  archived
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(customer)
  name         String
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orders       Order[]
  sessions     Session[]
  workshopRegs WorkshopRegistration[]
  actorLogs    AuditLog[] @relation("ActorLogs")
  assets       Asset[] @relation("AssetOwner")
  createdVideos InstructionVideo[] @relation("InstructionVideoCreator")
  updatedVideos InstructionVideo[] @relation("InstructionVideoUpdater")
  videoProgress UserVideoProgress[]
  productImages UserProductImage[]
  redeemCodes RedeemCode[] @relation("RedeemCodeCreator")
  redemptions RedeemCodeRedemption[]
  entitlements UserEntitlement[]
  blogPosts BlogPost[] @relation("BlogPostAuthor")
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  description String        @db.Text
  price       Int
  oldPrice    Int?
  // Extra cost for the "Smart" (IoT) variant at checkout. Null means this
  // product has no Smart variant — only Standard is offered.
  smartPriceDelta Int?
  category    String
  ageRange    String
  collection  String
  emoji       String        @default("🎨")
  badge       String?
  bgColor     String        @default("#FEF5EA")
  includes    String[]
  images      String[]
  videos      Json          @default("[]")
  status      ProductStatus @default(published)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orderItems OrderItem[]
  assets Asset[]
  instructionVideos InstructionVideo[]
  productImages UserProductImage[]
  redeemCodes RedeemCode[]
  entitlements UserEntitlement[]
}

model Order {
  id                 String      @id @default(cuid())
  userId             String
  status             OrderStatus @default(pending)
  total              Int
  shippingName       String
  shippingPhone      String
  shippingAddress    String
  note               String?
  paidAt             DateTime?
  sepayTransactionId Int?        @unique
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId Int
  qty       Int
  unitPrice Int
  // 'standard' | 'smart' — which variant was bought, when the product offers one.
  variant   String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Workshop {
  id        String   @id @default(cuid())
  title     String
  dateTime  DateTime
  capacity  Int
  location  String
  createdAt DateTime @default(now())

  registrations WorkshopRegistration[]
}

model WorkshopRegistration {
  id         String   @id @default(cuid())
  workshopId String
  userId     String?
  guestName  String?
  guestPhone String?
  createdAt  DateTime @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User @relation("ActorLogs", fields: [actorUserId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  data      Json?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Asset {
  id              String               @id @default(cuid())
  ownerUserId     String?
  productId       Int?
  kind            AssetKind
  storageProvider AssetStorageProvider
  key             String
  url             String
  mimeType        String
  sizeBytes       Int
  originalName    String?
  checksum        String?
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  ownerUser User? @relation("AssetOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  instructionVideos InstructionVideo[] @relation("InstructionVideoAsset")
  instructionVideoThumbs InstructionVideo[] @relation("InstructionVideoThumb")
  userProductImages UserProductImage[]
  blogCoverPosts BlogPost[] @relation("BlogCoverAsset")

  @@index([ownerUserId])
  @@index([productId])
  @@index([kind])
}

model InstructionVideo {
  id                String        @id @default(cuid())
  productId         Int
  assetId           String?
  title             String
  description       String?
  durationSec       Int?
  thumbnailAssetId  String?
  externalUrl       String?
  sortOrder         Int           @default(0)
  status            ContentStatus @default(draft)
  createdByUserId   String
  updatedByUserId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset Asset? @relation("InstructionVideoAsset", fields: [assetId], references: [id], onDelete: SetNull)
  thumbnailAsset Asset? @relation("InstructionVideoThumb", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)
  createdBy User @relation("InstructionVideoCreator", fields: [createdByUserId], references: [id])
  updatedBy User? @relation("InstructionVideoUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  progress UserVideoProgress[]

  @@index([productId, status, sortOrder])
}

model UserVideoProgress {
  id            String    @id @default(cuid())
  userId        String
  videoId       String
  progressSec   Int       @default(0)
  completedAt   DateTime?
  lastWatchedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  video InstructionVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model UserProductImage {
  id        String          @id @default(cuid())
  userId    String
  productId Int
  assetId   String
  title     String?
  note      String?
  status    UserImageStatus @default(active)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([userId, productId, status])
  @@index([productId, status])
}

model RedeemCode {
  id              String             @id @default(cuid())
  codeHash        String             @unique
  label           String
  description     String?
  features        RedeemFeature[]
  productId       Int?
  maxUses         Int?
  usedCount       Int                @default(0)
  perUserLimit    Int                @default(1)
  startsAt        DateTime?
  expiresAt       DateTime?
  status          RedeemCodeStatus   @default(active)
  createdByUserId String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdBy User @relation("RedeemCodeCreator", fields: [createdByUserId], references: [id])
  redemptions RedeemCodeRedemption[]

  @@index([productId])
  @@index([status])
}

model RedeemCodeRedemption {
  id           String   @id @default(cuid())
  redeemCodeId String
  userId       String
  redeemedAt   DateTime @default(now())

  redeemCode RedeemCode @relation(fields: [redeemCodeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([redeemCodeId, userId])
}

model UserEntitlement {
  id        String            @id @default(cuid())
  userId    String
  feature   RedeemFeature
  productId Int?
  source    EntitlementSource
  sourceId  String?
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, feature, productId])
  @@index([source, sourceId])
}

model BlogPost {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  excerpt      String?
  content      String         @db.Text
  coverAssetId String?
  recommendedProductIds Int[]  @default([])
  status       BlogPostStatus @default(draft)
  authorUserId String
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  coverAsset Asset? @relation("BlogCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  author User @relation("BlogPostAuthor", fields: [authorUserId], references: [id])

  @@index([status, publishedAt])
}
