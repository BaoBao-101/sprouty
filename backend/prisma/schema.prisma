generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  employee
  admin
}

enum UserStatus {
  active
  disabled
}

enum ProductStatus {
  published
  draft
  archived
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum AssetKind {
  product_image
  instruction_video
  instruction_video_thumb
  user_image
  blog_cover
  blog_inline
  workshop_cover
}

enum AssetStorageProvider {
  local
  s3
}

enum ContentStatus {
  draft
  published
  archived
}

enum UserImageStatus {
  active
  hidden
  deleted
}

enum RedeemFeature {
  ai_assistant
  instruction_videos
  image_uploads
}

enum RedeemCodeStatus {
  active
  disabled
  expired
}

enum EntitlementSource {
  purchase
  redeem_code
  admin_grant
}

enum BlogPostStatus {
  draft
  published
  archived
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(customer)
  name         String
  status       UserStatus @default(active)
  // Per-account brute-force lockout state (see routes/auth.js login handler).
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orders       Order[]
  sessions     Session[]
  workshopRegs WorkshopRegistration[]
  workshopCheckIns WorkshopRegistration[] @relation("WorkshopCheckIns")
  actorLogs    AuditLog[] @relation("ActorLogs")
  assets       Asset[] @relation("AssetOwner")
  createdVideos InstructionVideo[] @relation("InstructionVideoCreator")
  updatedVideos InstructionVideo[] @relation("InstructionVideoUpdater")
  videoProgress UserVideoProgress[]
  productImages UserProductImage[]
  redeemCodes RedeemCode[] @relation("RedeemCodeCreator")
  redemptions RedeemCodeRedemption[]
  entitlements UserEntitlement[]
  blogPosts BlogPost[] @relation("BlogPostAuthor")
  plants VirtualPlant[]
  rewards Reward[]
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  description String        @db.Text
  price       Int
  oldPrice    Int?
  // Extra cost for the "Smart" (IoT) variant at checkout. Null means this
  // product has no Smart variant — only Standard is offered.
  smartPriceDelta Int?
  category    String
  // Which plant the simulated kit grows: a key from SPECIES in
  // services/plant-sim.js, chosen by the admin when the product is created.
  // Null falls back to matching the product name, which is how the kits that
  // predate this column keep their species without a backfill.
  speciesKey  String?
  ageRange    String
  collection  String
  emoji       String        @default("🎨")
  badge       String?
  bgColor     String        @default("#FEF5EA")
  includes    String[]
  images      String[]
  videos      Json          @default("[]")
  status      ProductStatus @default(published)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orderItems OrderItem[]
  assets Asset[]
  instructionVideos InstructionVideo[]
  productImages UserProductImage[]
  redeemCodes RedeemCode[]
  entitlements UserEntitlement[]
  plants VirtualPlant[]
}

model Order {
  id                 String      @id @default(cuid())
  userId             String
  status             OrderStatus @default(pending)
  total              Int
  shippingName       String
  shippingPhone      String
  shippingAddress    String
  note               String?
  paidAt             DateTime?
  sepayTransactionId Int?        @unique
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId Int
  qty       Int
  unitPrice Int
  // 'standard' | 'smart' — which variant was bought, when the product offers one.
  variant   String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

enum WorkshopStatus {
  draft
  published
  cancelled
}

enum WorkshopRegistrationStatus {
  pending
  confirmed
  cancelled
}

enum WorkshopPaymentMethod {
  online
  onsite
}

// The public workshop page used to render a hardcoded array that carried a
// description, photo, age range and price — none of which existed here, so an
// admin could not produce a session that looked like the ones on the site.
// These columns are what that page actually displays.
model Workshop {
  id          String         @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  dateTime    DateTime
  // Optional: the page shows "9:00 – 11:30" when an end time is known.
  endTime     DateTime?
  capacity    Int
  location    String
  ageRange    String?
  price       Int            @default(0)
  status      WorkshopStatus @default(published)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  registrations WorkshopRegistration[]

  @@index([status, dateTime])
}

model WorkshopRegistration {
  id         String                     @id @default(cuid())
  workshopId String
  userId     String?
  guestName  String?
  guestPhone String?
  guestEmail String?
  // The public form always asked for these three and then discarded them.
  childAge   String?
  childCount Int                        @default(1)
  note       String?
  status     WorkshopRegistrationStatus @default(pending)

  // Paying up front is what secures a seat. An onsite booking is provisional:
  // the page says so, and staff see at a glance who has actually paid.
  paymentMethod       WorkshopPaymentMethod @default(onsite)
  // Captured when the booking is made, so a later change to Workshop.price
  // cannot break the amount the customer was quoted and the webhook checks.
  amount              Int                   @default(0)
  paidAt              DateTime?
  // Int, matching Order.sepayTransactionId — SePay's transaction id is numeric.
  sepayTransactionId  Int?                  @unique

  // Did the child actually turn up?
  //
  // Paying and attending are different facts, and they were conflated: a
  // booking paid for weeks ago says nothing about whether anyone walked
  // through the door, and staff on the day had nowhere to record that they
  // did. The parent sees it too, which is what makes the booking a ticket
  // rather than a receipt.
  checkedInAt       DateTime?
  checkedInByUserId String?
  // Seats actually filled. Usually equals childCount, but a parent who
  // booked two and brought one should not be recorded as bringing two.
  attendedCount     Int?

  createdAt  DateTime                   @default(now())

  workshop    Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])
  checkedInBy User?    @relation("WorkshopCheckIns", fields: [checkedInByUserId], references: [id])

  @@index([workshopId, status])
  @@index([workshopId, checkedInAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User @relation("ActorLogs", fields: [actorUserId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  data      Json?
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Asset {
  id              String               @id @default(cuid())
  ownerUserId     String?
  productId       Int?
  kind            AssetKind
  storageProvider AssetStorageProvider
  key             String
  url             String
  mimeType        String
  sizeBytes       Int
  originalName    String?
  checksum        String?
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  ownerUser User? @relation("AssetOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  instructionVideos InstructionVideo[] @relation("InstructionVideoAsset")
  instructionVideoThumbs InstructionVideo[] @relation("InstructionVideoThumb")
  userProductImages UserProductImage[]
  blogCoverPosts BlogPost[] @relation("BlogCoverAsset")

  @@index([ownerUserId])
  @@index([productId])
  @@index([kind])
  // Looked up on every /uploads/* request by the access guard (finding F-02).
  @@index([key])
}

model InstructionVideo {
  id                String        @id @default(cuid())
  productId         Int
  assetId           String?
  title             String
  description       String?
  durationSec       Int?
  thumbnailAssetId  String?
  externalUrl       String?
  sortOrder         Int           @default(0)
  status            ContentStatus @default(draft)
  createdByUserId   String
  updatedByUserId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset Asset? @relation("InstructionVideoAsset", fields: [assetId], references: [id], onDelete: SetNull)
  thumbnailAsset Asset? @relation("InstructionVideoThumb", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)
  createdBy User @relation("InstructionVideoCreator", fields: [createdByUserId], references: [id])
  updatedBy User? @relation("InstructionVideoUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  progress UserVideoProgress[]

  @@index([productId, status, sortOrder])
}

model UserVideoProgress {
  id            String    @id @default(cuid())
  userId        String
  videoId       String
  progressSec   Int       @default(0)
  completedAt   DateTime?
  lastWatchedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  video InstructionVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model UserProductImage {
  id        String          @id @default(cuid())
  userId    String
  productId Int
  assetId   String
  title     String?
  note      String?
  // Which growth stage the plant was at when this was saved, captured at upload
  // time. Null for anything uploaded before the album became a journey record,
  // and for a photo saved against a product the owner never activated.
  stage     PlantStage?
  status    UserImageStatus @default(active)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([userId, productId, status])
  @@index([productId, status])
}

model RedeemCode {
  id              String             @id @default(cuid())
  codeHash        String             @unique
  label           String
  description     String?
  features        RedeemFeature[]
  productId       Int?
  maxUses         Int?
  usedCount       Int                @default(0)
  perUserLimit    Int                @default(1)
  startsAt        DateTime?
  expiresAt       DateTime?
  status          RedeemCodeStatus   @default(active)
  createdByUserId String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdBy User @relation("RedeemCodeCreator", fields: [createdByUserId], references: [id])
  redemptions RedeemCodeRedemption[]

  @@index([productId])
  @@index([status])
}

model RedeemCodeRedemption {
  id           String   @id @default(cuid())
  redeemCodeId String
  userId       String
  redeemedAt   DateTime @default(now())

  redeemCode RedeemCode @relation(fields: [redeemCodeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([redeemCodeId, userId])
}

model UserEntitlement {
  id        String            @id @default(cuid())
  userId    String
  feature   RedeemFeature
  productId Int?
  source    EntitlementSource
  sourceId  String?
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, feature, productId])
  @@index([source, sourceId])
}

model BlogPost {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  excerpt      String?
  content      String         @db.Text
  coverAssetId String?
  recommendedProductIds Int[]  @default([])
  status       BlogPostStatus @default(draft)
  authorUserId String
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  coverAsset Asset? @relation("BlogCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  author User @relation("BlogPostAuthor", fields: [authorUserId], references: [id])

  @@index([status, publishedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Virtual plants
//
// Sprouty no longer ships a physical kit. Buying a kit now unlocks a simulated
// plant that lives entirely on the site: the customer activates it with the
// code their order issued, and raises it from seed to harvest through care
// actions that each have a cooldown, reading simulated IoT sensors as they go.
//
// Nothing here is advanced by a scheduler. Every metric is a function of the
// time elapsed since `lastTickAt`, recomputed whenever the plant is read or
// cared for (see services/plant-sim.js). A cron job would be a second source
// of truth for the same numbers, and would have to run in a container that
// currently only serves requests.
// ─────────────────────────────────────────────────────────────────────────────

enum PlantStage {
  seed
  sprout
  seedling
  vegetative
  budding
  flowering
  fruiting
  mature
}

enum PlantCareAction {
  water
  mist
  fertilize
  prune
  pest_check
  sunlight
  loosen_soil
  pollinate
  harvest
}

enum PlantDeviceType {
  moisture_sensor
  thermo_sensor
  light_sensor
  nutrient_sensor
  water_pump
  grow_light
  fan
  camera
}

model VirtualPlant {
  id        String     @id @default(cuid())
  userId    String
  productId Int
  // What the child named it. Defaults to the product name on activation.
  nickname  String
  stage     PlantStage @default(seed)
  // 0–100 within the current stage. Float because a tick adds fractions of a
  // percent, and rounding each one down would stall growth entirely.
  stageProgress Float  @default(0)
  // Lifetime growth points, kept across stage changes for the progress badge.
  growthPoints  Float  @default(0)

  // Simulated soil/plant state, all 0–100.
  moisture  Float @default(45)
  nutrient  Float @default(60)
  health    Float @default(85)
  pestRisk  Float @default(5)

  // Consecutive days with at least one care action, and the day that streak
  // was last extended (date-only, local time) so a second visit the same day
  // does not count twice.
  careStreak    Int      @default(0)
  lastCareDate  String?
  // Every metric above is only meaningful together with the moment it was
  // computed for.
  lastTickAt    DateTime @default(now())
  harvestedAt   DateTime?
  activatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  devices PlantDevice[]
  careLogs PlantCareLog[]
  readings PlantSensorReading[]
  coachMessages PlantCoachMessage[]

  // One plant per kit per account: the activation code is single-use and
  // per-product, so a second plant for the same kit could only come from a
  // double-submit.
  @@unique([userId, productId])
  @@index([userId])
}

model PlantDevice {
  id       String          @id @default(cuid())
  plantId  String
  type     PlantDeviceType
  // Sensors unlock as the plant grows, so the dashboard starts simple.
  unlocked Boolean         @default(false)
  // Actuators (pump, grow light, fan) can run themselves. Automation keeps a
  // plant alive while nobody is looking but grants no growth — care the child
  // actually performs is what moves the plant forward.
  autoMode Boolean         @default(false)
  // Solar-charged, drains with use. Flavour, and a reason the dashboard can
  // teach that a real sensor needs power.
  battery  Float           @default(100)

  plant VirtualPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, type])
}

model PlantCareLog {
  id       String          @id @default(cuid())
  plantId  String
  action   PlantCareAction
  stage    PlantStage
  // Growth awarded, and the metric deltas, so the page can explain what the
  // action actually did instead of just saying "done".
  growth   Float           @default(0)
  detail   Json?
  createdAt DateTime       @default(now())

  plant VirtualPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  // The cooldown for an action is derived from the newest row for it — no
  // per-action timestamp column that could disagree with this log.
  @@index([plantId, action, createdAt])
  @@index([plantId, createdAt])
}

/// What the child and Plant Buddy have said to each other about one plant.
///
/// Kept on the server rather than in the browser for two reasons: a child may
/// open their garden on the family tablet and then a phone, and the coach can
/// only answer a follow-up like "tại sao?" if it is given the turns that came
/// before. Trimmed to a recent window; this is a conversation, not an archive.
model PlantCoachMessage {
  id        String   @id @default(cuid())
  /// Total order within a plant's thread.
  ///
  /// createdAt cannot do this job: a question and its answer are written
  /// together and land on the same millisecond, so ordering by time put the
  /// answer before the question about half the time. Replayed that way the
  /// model saw two user turns in a row and returned nothing at all.
  seq       Int      @default(autoincrement())
  plantId   String
  /// 'user' or 'assistant' — mirrors the roles the AI providers expect.
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  plant VirtualPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, seq])
}

model PlantSensorReading {
  id          String   @id @default(cuid())
  plantId     String
  moisture    Float
  temperature Float
  humidity    Float
  light       Float
  nutrient    Float
  health      Float
  recordedAt  DateTime @default(now())

  plant VirtualPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, recordedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Rewards
//
// "Buy 3 planting products, get one workshop of your choice free." Earned
// rewards are rows rather than a computed count: a claimed one has to stay
// claimed even after the customer buys more, and staff need to see which
// booking a free seat was spent on.
// ─────────────────────────────────────────────────────────────────────────────

enum RewardType {
  free_workshop
}

enum RewardStatus {
  available
  claimed
}

model Reward {
  id       String       @id @default(cuid())
  userId   String
  type     RewardType   @default(free_workshop)
  status   RewardStatus @default(available)
  // Which purchase milestone minted it: the n-th completed set of three.
  milestone Int
  claimedRegistrationId String?
  claimedAt DateTime?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What makes earning idempotent: syncing rewards after a payment can only
  // ever insert the milestones that are missing.
  @@unique([userId, type, milestone])
  @@index([userId, status])
}
